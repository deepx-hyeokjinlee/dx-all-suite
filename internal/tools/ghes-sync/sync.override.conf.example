# sync.override.conf — YOUR local values, applied on top of sync.conf (same INI format).
# Copy this file to sync.override.conf (gitignored) and edit. Only the keys you set here change.
#
#   cp internal/tools/ghes-sync/sync.override.conf.example internal/tools/ghes-sync/sync.override.conf

[defaults]
src_host = https://github.com/{DEEPX-MIRROR-ORG}   # your private github.com mirror org (https only)
branch   = feature/{my-topic}                     # the feature branch you sync (same name on GHES)
# branch = none                                   # no feature branch yet — `--reverse` then syncs only the
#                                                 # integration branches (pr_base + main) GHES -> mirror.
#                                                 # Do NOT write main/dev here instead: --reset-to-base
#                                                 # would force-rewrite that branch on mirror AND GHES.

# Optional. `reverse_branches` (same-name branches for --reverse) can live under [defaults]
# (all repos) and/or under a [repo NAME] section (that repo only, wins over [defaults]).
# Unset = branch + pr_base + main per repo — usually what you want.
# reverse_branches = feature/{my-topic} main
#
# [repo dx_app]
# pr_base = dev
# reverse_branches = feature/{my-topic} dev main
